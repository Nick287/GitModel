# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Local data & secrets (never bake into the image)
db/
db-container/
*.db
*.db-wal
*.db-shm
.env

# Infra / tooling — not part of the app image. infra/.terraform holds large
# provider binaries that are also locked during `terraform apply`, which would
# break `az acr build`'s context packing.
infra/
.claude/
.devcontainer/

# VCS / editor / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs / meta
README.md
Dockerfile
.dockerignore
docker-compose.yml
