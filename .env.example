# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit real keys.
#
# Used by scripts/test_online.py, scripts/test_all_models.py, scripts/test_cache.py

# Base URL of the GitModel Hub to test.
# Production (default workspace):
HUB_BASE_URL=https://****************.io
# Example for the "liang" environment:
# HUB_BASE_URL=https://gitmodelliang-hub.azurecontainerapps.io

# Client API key (create one in the hub's admin portal → Keys).
HUB_API_KEY=sk-hub--replace-with-your-key

# Default model for scripts/test_online.py (other scripts have their own defaults).
HUB_MODEL=gpt-4o-mini
